# Copy to .env and adjust. Never commit .env. Placeholders only.
APP_NAME=HireMatch
# development | production (production hides /docs unless EXPOSE_API_DOCS=true)
ENVIRONMENT=development
# EXPOSE_API_DOCS=false

# Direct local runs use SQLite; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./hirematch.db
POSTGRES_DB=hirematch
POSTGRES_USER=hirematch
POSTGRES_PASSWORD=change-me-for-shared-environments

# Document reading. MOCK_LLM=true uses deterministic built-in rules (no AI provider, no cost).
# MOCK_LLM=false requires an OpenRouter key. The key is only ever read by the backend.
MOCK_LLM=true
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_BUDGET_SECONDS=90
LLM_MAX_INPUT_CHARS=20000

# Sessions (set SESSION_COOKIE_SECURE=true behind HTTPS)
SESSION_COOKIE_NAME=hirematch_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Origins allowed to make credentialed requests (only needed if the UI is served from another origin).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Limits
MAX_UPLOAD_SIZE_MB=10
MAX_PAGES_PER_DOCUMENT=30
MAX_JOB_DESCRIPTION_CHARS=20000
MAX_RESUME_TEXT_CHARS=40000
MAX_RESUMES_PER_USER=100
MAX_JOBS_PER_USER=500
RATE_LIMIT_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_15_MINUTES=10
PROCESSING_STALE_MINUTES=10

# Docker Compose published ports
API_PORT=8000
WEB_PORT=8080
